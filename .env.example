# PlacementPal Environment Configuration
PORT=5000

# Primary Open-Weight Model Provider
# Supported providers: "ollama", "groq", "openrouter", "google_ai_studio", "huggingface"
AI_PROVIDER=ollama

# Model Identifier
# For Ollama: gemma:2b, gemma:7b, gemma2, gemma2:9b
# For Groq: gemma2-9b-it
# For OpenRouter: google/gemma-2-9b-it
# For Google AI Studio: gemma-2-9b-it
GEMMA_MODEL_NAME=gemma2:9b

# Ollama Endpoint (Used if AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# API Keys (Required for remote providers like Groq, OpenRouter, Google AI Studio, HuggingFace)
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
HUGGINGFACE_API_KEY=

# Fallback behavior if AI API fails or is not configured
# Options: "fallback_engine" (uses built-in smart evaluation engine) or "error"
FAILURE_STRATEGY=fallback_engine
